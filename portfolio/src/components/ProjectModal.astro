---
import { render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

interface Props { project: CollectionEntry<'projects'>; }
const { project } = Astro.props;
const key = project.id;
const { title, tagline, kind, demoUrl, demoNote, gallery, video, chips } = project.data;

// The modal write-up is the project's MDX BODY, authored as real Markdown.
// `<ArchDiagram name="…"/>` dropped inline in that body renders the diagram in
// place. `<Content/>` emits the whole thing; the wrapping `.m-body` lets the
// CSS style Markdown paragraphs exactly like the old hand-written ones.
const { Content } = await render(project);
---
<div class="modal-src" id={`src-${key}`}>
  <p class="m-eyebrow">Consulting · {kind}</p>
  <h3 set:html={title}></h3>
  <p class="m-tag" set:html={tagline}></p>
  {demoUrl && (
    <div class="m-cta"><a class="btn" href={demoUrl}>Launch live demo →</a><span class="note">{demoNote}</span></div>
  )}
  {gallery && (
    <div class="m-gallery">
      {gallery.map((g) => <img src={g.src} alt={g.alt} loading="lazy" />)}
    </div>
  )}
  <div class="m-body"><Content /></div>
  {video && (
    <div class="m-media">
      <video src={video.src} controls muted loop playsinline preload="metadata"></video>
      <p class="m-cap">{video.cap}</p>
    </div>
  )}
  <ul class="chips">{chips.map((c) => <li>{c}</li>)}</ul>
</div>
